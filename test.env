# ── Spring ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=7102

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=identity
DATABASE_USERNAME=identity_admin
DATABASE_PASSWORD=postgres
JPA_SHOW_SQL=false

